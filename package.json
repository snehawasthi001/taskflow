    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.0.0",
    "prisma": "6.6.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
