# TaskFlow environment template.
# Copy to .env for local Docker demos. Use Jenkins/Kubernetes secrets for production.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001
API_URL=http://backend:3001
PORT=3001

# Database
DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow
DIRECT_DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# Redis
REDIS_URL=redis://redis:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=replace-with-openssl-rand-hex-32

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# DevOps platform
GRAFANA_ADMIN_PASSWORD=taskflow-admin
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true
NEXUS_REGISTRY=nexus:8082
AWS_REGION=us-east-1
METRICS_ENABLED=true
